{
  "name": "radio-do-box-remotion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:data": "node scripts/sync-f1.mjs",
    "dashboard": "node --env-file=.env scripts/dashboard-server.mjs",
    "dev": "node scripts/dev.mjs",
    "studio": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render": "SPORT=f1 node --env-file=.env scripts/render-current-job.mjs",
    "build:online": "node scripts/online/build.mjs",
    "start:online": "node scripts/online/start.mjs",
    "test:online": "node --test tests/online/*.test.mjs",
    "backup:online": "node scripts/online/backup.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "jose": "6.1.3",
    "openid-client": "6.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.532",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.532",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.25.12",
    "typescript": "^5.6.3"
  }
}
