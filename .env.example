F1_API_KEY=your_api_sports_key
F1_API_HOST=v1.formula-1.api-sports.io
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-5.2

# Railway only: configure these in Railway Variables, not in the image.
# Requires Node 24. Two Google accounts, separated by a comma.
# PUBLIC_URL=https://your-service.up.railway.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAILS=you@gmail.com,sister@gmail.com
# APP_DATA_DIR=/data
# PORT=4321
